# Copy to .env (never commit .env). Used by docker compose.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Several keys, comma-separated, are all accepted (for rotation).
API_KEY=change-me-to-a-long-random-string
# A different key for endpoints that change the served model (/shadow/promote, ...).
# Leave empty to disable them in production.
ADMIN_API_KEY=
API_WORKERS=1
LOG_LEVEL=INFO
# Grafana admin login (docker compose --profile monitoring). Viewing needs no login.
GRAFANA_ADMIN_PASSWORD=change-me
